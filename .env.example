# ============================================
# KOPIRATI u .env.local i popuniti vrednosti
# ============================================

# URL sajta (bez trailing slash) – pravi domen pre lansiranja
NEXT_PUBLIC_SITE_URL=https://detektiv-marinkovic.rs

# Naziv sajta
NEXT_PUBLIC_SITE_NAME=Detektiv Marinković

# ── Kontakt forma -> Mailjet Send API v3.1 ──
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Verifikovan sender (adresa ili domen) u Mailjet nalogu
SITE_MAIL_SENDER=noreply@example.com
# Adresa na koju stižu upiti sa sajta
SITE_MAIL_RECEIVER=mddetektiv@gmail.com

# Google Analytics (opciono)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
